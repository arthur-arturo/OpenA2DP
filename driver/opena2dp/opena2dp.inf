[Version]
Signature="$WINDOWS NT$"
Class=Bluetooth
ClassGuid={e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider=%ProviderString%
DriverVer=10/29/2026,0.1.0.0
CatalogFile=opena2dp.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskId1%,,,""

[SourceDisksFiles]
opena2dp.sys=1,,

[Manufacturer]
%ManufacturerString%=OpenA2DP,NTamd64

[OpenA2DP.NTamd64]
%OpenA2DP.DeviceDesc%=OpenA2DP_Install,BTHENUM\{0000110b-0000-1000-8000-00805f9b34fb}

[OpenA2DP_Install.NT]
CopyFiles=OpenA2DP_CopyFiles

[OpenA2DP_CopyFiles]
opena2dp.sys

[OpenA2DP_Install.NT.Services]
AddService=opena2dp,%SPSVCINST_ASSOCSERVICE%,OpenA2DP_ServiceInstall

[OpenA2DP_ServiceInstall]
DisplayName=%OpenA2DP.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\opena2dp.sys

[OpenA2DP_Install.NT.Wdf]
KmdfService=opena2dp,OpenA2DP_KmdfInstall

[OpenA2DP_KmdfInstall]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE=0x00000002
ProviderString="OpenA2DP contributors"
ManufacturerString="OpenA2DP contributors"
DiskId1="OpenA2DP installation media"
OpenA2DP.DeviceDesc="OpenA2DP A2DP Audio Endpoint (development)"
OpenA2DP.ServiceDesc="OpenA2DP A2DP Profile Driver"
